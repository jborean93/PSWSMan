<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <!--MonoMod.Utils already exposes IgnoresAccessChecksToAttribute publicly-->
    <IgnoresAccessChecksToOmitAttributeDefinition>true</IgnoresAccessChecksToOmitAttributeDefinition>
  </PropertyGroup>

  <ItemGroup>
    <IgnoresAccessChecksTo Include="System.Management.Automation" />
    <InternalsVisibleTo Include="PSWSMan.Connection.Tests" />
    <InternalsVisibleTo Include="PSWSMan.Authentication.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
    The package's build targets add a NativeReference on macOS hosts which only the .NET Framework MSBuild can
    resolve. The native libraries arrive through the runtimes/<rid>/native assets so the targets are not needed.
    -->
    <PackageReference Include="Devolutions.Sspi" ExcludeAssets="build" />
    <PackageReference Include="MonoMod.RuntimeDetour" />
    <ProjectReference Include="../PSWSMan.Lib/PSWSMan.Lib.csproj" />
    <ProjectReference Include="../PSWSMan.Loader/PSWSMan.Loader.csproj" />
    <PackageReference Include="IgnoresAccessChecksToGenerator" PrivateAssets="All" />
    <PackageReference Include="System.Formats.Asn1" PrivateAssets="all" />
    <!--
    The module patches internal S.M.A types so it must compile against the real implementation assembly rather than
    the reference assembly in the package's ref/ folder. Every asset is excluded so none of the package or its
    dependencies end up in the published module, the package is only restored to give us a path to compile against.
    -->
    <PackageReference Include="System.Management.Automation" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <Reference Include="$(PkgSystem_Management_Automation)/runtimes/win/lib/$(TargetFramework)/System.Management.Automation.dll" Private="false" />
  </ItemGroup>
</Project>
