<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <!--
    Unlike the other unit test projects this references the module assembly directly. The transport classes under
    test never touch System.Management.Automation so it is not loaded at runtime, but building the module does need
    the reference assembly that build.ps1 downloads into output/.
    -->
    <ProjectReference Include="../../../src/PSWSMan/PSWSMan.csproj" />
  </ItemGroup>

</Project>
